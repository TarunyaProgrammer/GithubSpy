# Umami Cloud default: https://cloud.umami.is/script.js
# For self-hosted Umami, use your instance's /script.js URL instead.
VITE_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
VITE_UMAMI_WEBSITE_ID=replace-with-your-umami-website-id

# Optional when the tracker script and collection API are hosted separately.
# VITE_UMAMI_HOST_URL=https://cloud.umami.is
